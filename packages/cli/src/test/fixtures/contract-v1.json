{
	"$comment": "Server-CLI contract v1 for agx login (agx login build spec 2026-09-30, sections 1.2, 1.3, 1.5, 1.6 and 1.7). The SHAPES are the contract: keys, value types, and which keys are present or absent. Values are the spec's examples, placeholders included. The server copy lives at packages/api/modules/device-auth/__tests__/fixtures/contract-v1.json in elacity-mega; a change to either copy needs a change to the spec. The agx mock index server (src/test/mock-index-server.ts) serves these bodies.",
	"version": 1,
	"scopes": ["listings:read", "listings:write", "domains:read", "domains:write"],
	"userCodePattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{4}-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{4}$",
	"deviceCode": {
		"method": "POST",
		"path": "/api/auth/device/code",
		"request": {
			"client_id": "agx",
			"scope": "listings:read listings:write domains:read domains:write",
			"host_label": "alices-mbp"
		},
		"requestOptionalFields": ["org_hint", "new_org", "new_org_name", "new_org_slug"],
		"response": {
			"device_code": "3f9c…(64 hex)",
			"user_code": "WDJB-MJHT",
			"verification_uri": "https://app.ellaworks.ai/auth/device",
			"verification_uri_complete": "https://app.ellaworks.ai/auth/device?code=WDJB-MJHT",
			"expires_in": 1800,
			"interval": 5,
			"scope": "listings:read listings:write domains:read domains:write"
		},
		"legacyResponseKeys": [
			"device_code",
			"user_code",
			"verification_uri",
			"verification_uri_complete",
			"expires_in",
			"interval"
		],
		"legacyExpiresIn": 900,
		"errors": {
			"invalid_request": { "status": 400, "body": { "error": "invalid_request", "error_description": "…" } },
			"invalid_client": { "status": 400, "body": { "error": "invalid_client" } },
			"invalid_scope": { "status": 400, "body": { "error": "invalid_scope" } },
			"rate_limited": {
				"status": 429,
				"headers": { "Retry-After": "60" },
				"body": { "error": "rate_limited", "error_description": "…" }
			},
			"server_error": { "status": 500, "body": { "error": "server_error" } }
		}
	},
	"deviceToken": {
		"method": "POST",
		"path": "/api/auth/device/token",
		"request": {
			"grant_type": "urn:ietf:params:oauth:grant-type:device_code",
